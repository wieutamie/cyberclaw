{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/retention",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
