NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1leGFtcGxlIQ==
# Anonymous session signing. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SYSTEM_VT_API_KEY=
# Shared secret for the serverless retention cron endpoint (optional on Vercel).
CRON_SECRET=
VT_BASE_URL=https://www.virustotal.com/api/v3
VT_RATE_LIMIT_PER_MIN=4
# Hash cache TTL in hours (default 24). Cache is in-memory, resets on restart.
VT_HASH_CACHE_TTL_HOURS=24
MAX_UPLOAD_MB=32
LOG_LEVEL=info
