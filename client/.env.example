# Base URL for the CyberClaw backend API.
# Use "/api" to rely on the Vite dev proxy (see vite.config.ts), or an absolute
# URL like "https://<backend-domain>/api" for a deployed backend (Railway/Render).
VITE_API_BASE_URL=/api

# --- Public Supabase values (safe to expose in the frontend) ------------------
# The anon key is a PUBLIC key protected by Row Level Security. NEVER put the
# service_role key, VT API key, or any secret in a VITE_* variable.
# Only needed if/when the client talks to Supabase directly (e.g. OAuth login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

